<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.alphascope.market.mapper.InstrumentAdminMapper">
  <insert id="create">
    <![CDATA[
    INSERT INTO instrument(symbol, name, exchange, type, listed_at, active)
    VALUES(#{symbol}, #{name}, #{exchange}, #{type}, #{listedAt}, 1)
    ]]>
  </insert>
  <update id="lifecycle">UPDATE instrument SET listed_at=#{listedAt},delisted_at=#{delistedAt},lifecycle_source=#{source},lifecycle_observed_at=#{observedAt},lifecycle_evidence_json=#{evidenceJson},lifecycle_hash=SHA2(#{evidenceJson},256) WHERE symbol=#{symbol}</update>
</mapper>
