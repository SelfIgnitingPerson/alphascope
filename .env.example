# 复制为根目录 .env 后编辑；已有 .env 不覆盖。本模板不保存真实密钥。
# 变量职责、默认值与高级配置见 docs/runbook/configuration.md。

# 1. Java：可选；未配置时检测系统已安装的 Java 21。
# JAVA_HOME=/path/to/jdk-21
# 本机工具默认访问Docker或前端同源入口；只启动后端时可显式改成http://127.0.0.1:8080。
ALPHASCOPE_API_BASE=http://127.0.0.1:5173

# 2. 本机 MySQL 8：先创建库及专用账号，再启动后端；正常运行不需要Docker。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=alphascope
MYSQL_USER=alphascope
MYSQL_PASSWORD=replace_with_random_password
# 可选开发容器才需要以下密码；已有账号密码不会随.env自动改变。
# DOCKER_MYSQL_PORT=3307
# MYSQL_ROOT_PASSWORD=replace_with_another_random_password

# 3. 行情：免费优先；Tushare 仅有 Token 和权限时启用。
# 演示模式必须显式设 MARKET_PROVIDER=demo。
MARKET_PROVIDER=multi
MARKET_CHANNELS=exchange-calendar,baostock,sina,eastmoney,tushare
TUSHARE_TOKEN=
# 免费节点本机请求预算，包含登录/分页/失败重试；不代表同一出口IP其他程序。
BAOSTOCK_DAILY_BUDGET=40000
MARKET_CACHE_MINUTES=1440
# MARKET_CACHE_MINUTES=0 强制重新采集；冷却默认30秒。
# MARKET_COOLDOWN_SECONDS=30

# 4. 模型：none 仍生成包含实际个股事实的规则版报告。
# 启用模型时将 AI_CHAT_MODEL 改为 openai，并填写服务配置。
AI_CHAT_MODEL=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# 5. 定时触发：false 不影响页面提交的后台任务。
SCHEDULER_ENABLED=false

# 自选研究默认不评估个人持仓；免费财报由 Java 直接采集。
POSITION_RISK_ENABLED=false
FINANCIAL_SYNC_ENABLED=true


# 6. 任务与历史验证：时限为每个阶段的硬截止，心跳不会延长。
JOB_STAGE_TIMEOUT=2h
BACKTEST_MINIMUM_SAMPLES=20

# 7. 自动备份：应用运行且 Docker 可用时执行；启用后实际隔离恢复验证。
# 初次启动默认关闭，请先执行 scripts/tools.sh backup 验证本机能力。
BACKUP_ENABLED=false
BACKUP_CRON='0 0 2 * * *'
BACKUP_RETENTION_DAYS=14

# 可选第二存储：必须是已存在的磁盘/挂载目录；未配置时明确显示未配置。
BACKUP_SECONDARY_DIRECTORY=

# 8. 本机开发使用LOCAL；PUBLIC部署使用deploy/production.env.example和HTTPS网关。
ACCESS_MODE=LOCAL
SESSION_COOKIE_SECURE=true
REGISTRATION_ENABLED=false
REGISTRATION_INVITATION=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# PUBLIC_ORIGINS=https://research.example.com
