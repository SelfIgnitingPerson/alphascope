# 复制为deploy/.env并设置权限600。不要提交真实密码或合同凭据。
PUBLIC_HOST=research.example.com
ACME_EMAIL=replace-with-owner@example.com
MYSQL_PASSWORD=replace-with-random-database-secret
MYSQL_ROOT_PASSWORD=replace-with-another-random-secret
ADMIN_USERNAME=replace-admin-name
ADMIN_PASSWORD=replace-with-at-least-12-random-characters
REGISTRATION_ENABLED=false
# 开放注册时设置至少24字符的随机邀请口令，并只交给受邀用户。
REGISTRATION_INVITATION=
MARKET_CHANNELS=exchange-calendar,baostock,sina,eastmoney,tushare
TUSHARE_TOKEN=
SCHEDULER_ENABLED=false
ALPHASCOPE_IMAGE=alphascope:0.1.0
# 备份默认关闭；不自动创建当前业务库备份。
